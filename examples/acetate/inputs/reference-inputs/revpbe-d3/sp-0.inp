&GLOBAL
  PROJECT_NAME sp
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY_FORCE
  WALLTIME 03:50:00
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &SUBSYS
    &TOPOLOGY
      COORD_FILE_NAME md-pos-1.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &CELL
      ABC [angstrom] 15.7107 15.7107 15.7107
      PERIODIC XYZ
    &END CELL
    &KIND C
      BASIS_SET TZV2P-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET TZV2P-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Ca
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q10
      POTENTIAL GTH-PBE-q10
    &END KIND
  &END SUBSYS

  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &SCF
      MAX_SCF 30
      EPS_SCF 5e-07
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 5e-07
      &END OUTER_SCF
      &OT
        PRECONDITIONER FULL_ALL
        ENERGY_GAP -1.0
        MINIMIZER DIIS
      &END OT
    &END SCF

    &MGRID
      CUTOFF [Ry] 400.0
      REL_CUTOFF [Ry] 60.0
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1e-12
      EXTRAPOLATION_ORDER 4
      EXTRAPOLATION ASPC
    &END QS

    &XC
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION REVPBE
        &END PBE
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV NN50_SMOOTH
      &END XC_GRID
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL revPBE
          R_CUTOFF [angstrom] 16.0
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

    CHARGE -1
    MULTIPLICITY 1
    UKS .FALSE.
  &END DFT

  &PRINT
    &FORCES ON
      FILENAME __STD_OUT__
    &END FORCES
  &END PRINT
&END FORCE_EVAL
