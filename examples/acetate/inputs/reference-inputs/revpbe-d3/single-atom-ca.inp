&GLOBAL
  PROJECT_NAME Ca_vacuum
  PRINT_LEVEL LOW
  RUN_TYPE ENERGY
  PREFERRED_FFT_LIBRARY FFTW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &SUBSYS
    &TOPOLOGY
      COORD_FILE_NAME pos.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &CELL
      ABC [angstrom] 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
    &KIND Ca
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q10
      POTENTIAL GTH-PBE-q10
    &END KIND
  &END SUBSYS

  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &SCF
      MAX_SCF 200
      EPS_SCF 1e-06
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
        ENERGY_GAP 0.05
      &END OT
      SCF_GUESS ATOMIC
    &END SCF

    &MGRID
      CUTOFF [Ry] 400.0
      REL_CUTOFF [Ry] 60.0
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1e-12
    &END QS

    &XC
      &XC_FUNCTIONAL
        &PBE
          PARAMETRIZATION REVPBE
        &END PBE
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV NN50_SMOOTH
      &END XC_GRID
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL revPBE
          R_CUTOFF [angstrom] 16.0
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

    CHARGE 0
    MULTIPLICITY 1
    UKS .FALSE.
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
  &END DFT
&END FORCE_EVAL
